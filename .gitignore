tmp/
temp/
coverage/
*.log
*.debug
debug-output.txt
npm-debug.log*

# Editors and operating systems
.vs/
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
