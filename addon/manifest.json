{
  "manifest_version": 2,
  "name": "Zotero Scholar Assistant",
  "version": "1.3.7",
  "description": "Imports paper lists, retrieves open PDFs, and creates Ollama- or Google Gemini-powered highlights, study notes, and quizzes.",
  "author": "Pawan Saxena",
  "homepage_url": "https://github.com/Saxena224pawan/zotero-scholar-assistant",
  "icons": {
    "48": "chrome/content/icons/icon.svg",
    "96": "chrome/content/icons/icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "scholar-assistant@zotero-plugin.local",
      "update_url": "https://raw.githubusercontent.com/Saxena224pawan/zotero-scholar-assistant/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
