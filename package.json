{
  "name": "zotero-scholar-assistant",
  "version": "1.3.8",
  "private": true,
  "type": "module",
  "description": "A Zotero 10 research-paper assistant powered by Ollama or Google Gemini.",
  "author": "Pawan Saxena",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saxena224pawan/zotero-scholar-assistant.git"
  },
  "homepage": "https://github.com/Saxena224pawan/zotero-scholar-assistant#readme",
  "bugs": {
    "url": "https://github.com/Saxena224pawan/zotero-scholar-assistant/issues"
  },
  "scripts": {
    "clean": "node scripts/build.mjs --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs && npm run typecheck && npm test",
    "release:manifest": "node scripts/write-update-manifest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.3.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
